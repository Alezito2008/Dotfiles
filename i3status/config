# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
        colors = true
        interval = 1
}

# order += "ipv6"
order += "volume master"
order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
# order += "disk /"
# order += "load"
order += "read_file brightness"
order += "memory"
order += "tztime local"
order += "tztime date"

volume master {
        #format = "🔊 %volume"
        format = "  %volume"
        format_muted = " "
        color_degraded = "#cdd6f4"
        device = "default"
        mixer = "Master"
}

wireless _first_ {
        # format_up = "W: (%quality at %essid) %ip"
        #format_up = "🌐 %essid"
        format_up = "  %essid"
        format_down = "󰖪 "
        color_good = "#cdd6f4"
}

ethernet _first_ {
        #format_up = "E: %ip (%speed)"
        format_up = "󰈀 %ip"
        # format_down = "E: down"
        format_down = ""
}

battery all {
        format = "%status%percentage"
        #status_bat = "🔋 "
        status_bat = "󰁹 "
        #status_chr = "⚡ "
        status_chr = "󰂄 "
        low_threshold = 25
        threshold_type = "percentage"
}

disk "/" {
        format = "%avail"
}

load {
        format = "%1min"
}

memory {
        # format = "%used | %available"
        #format = "💾 %used"
        format = "  %used"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

tztime local {
        #format = "⏱️ %T"
        format = "  %T"
}

tztime date {
        #format = "🗓️ %A, %B %d"
        #format = "󰃭  %d/%m"
        format = "󰃭 %A, %B %d"
}

read_file brightness {
        #format = "💡 %content"
        format = "󰃠 %content"
        max_characters = 3
        color_good = "#cdd6f4"
        path = "~/.config/sway/brightness"
}
